# Copy to .env and fill in. Never commit .env.
# Local dev default is SQLite; set this to PostgreSQL in production:
# postgresql+asyncpg://user:password@host:5432/foba
DATABASE_URL=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SHOPIFY_SHOP=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=
GOOGLE_SHEETS_ID=
GOOGLE_CREDS_JSON=/path/to/service-account.json
